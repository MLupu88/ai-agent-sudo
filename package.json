{
  "name": "ai-agent-sudo",
  "version": "0.1.0",
  "description": "Tiny provider-neutral authorization layer for AI agents: allow / deny / require_approval.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-sudo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test",
    "example": "node examples/protect-tool-call.ts",
    "example:cross-runtime": "node examples/cross-runtime/cross-runtime-proof.ts"
  },
  "keywords": [
    "authorization",
    "policy",
    "access-control",
    "permissions",
    "ai-agent",
    "agent",
    "tool-use",
    "tool-calling",
    "guardrails",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MLupu88/ai-agent-sudo.git"
  },
  "homepage": "https://github.com/MLupu88/ai-agent-sudo#readme",
  "bugs": {
    "url": "https://github.com/MLupu88/ai-agent-sudo/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
